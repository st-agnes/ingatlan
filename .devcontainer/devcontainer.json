{
  "name": "Ingatlan · .NET 8 és MySQL 8",
  "dockerComposeFile": "compose.yml",
  "service": "development",
  "workspaceFolder": "/workspaces/ingatlan",
  "runServices": [
    "development",
    "mysql"
  ],
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Otthonra web és API",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    },
    "5080": {
      "label": ".NET API",
      "onAutoForward": "ignore",
      "protocol": "http"
    },
    "8080": {
      "label": "Régi fejlesztői port – használd a 3000-et",
      "onAutoForward": "ignore",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash scripts/cloud-setup.sh",
  "postStartCommand": "node scripts/dev.mjs --background",
  "postAttachCommand": "node scripts/dev.mjs --background",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp"
      ]
    }
  }
}
