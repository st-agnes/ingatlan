# Copy to .env. Replace all values; .env is not committed or deployed.
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-root-password
JWT_KEY=replace-with-a-private-random-key-at-least-32-characters-long
ASPNETCORE_ENVIRONMENT=Development
FRONTEND_ORIGIN=http://localhost:8080
DATABASE_INITIALIZE=true
SEED_DEMO=true
ENABLE_DEMO_TOPUP=true

# Optional: Stripe test keys for real checkout integration. Keep keys server-side.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8080/?payment=success#credits
STRIPE_CANCEL_URL=http://localhost:8080/?payment=cancel#credits
